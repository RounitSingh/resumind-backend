DATABASE_URL=postgresql://user:password@host/db?sslmode=require
PORT=3001
NODE_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=5
LLM_TIMEOUT_MS=60000
# Max simultaneous Gemini calls across all users (extra calls queue). Raise on a paid key.
LLM_CONCURRENCY=3
GEMINI_FALLBACK_MODEL=
LLM_DEBUG=

COOKIE_SAMESITE=

# --- Auth ---
# Required, min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Optional: this email becomes admin when it registers
ADMIN_EMAIL=

# Max uploaded resumes per account
MAX_RESUMES_PER_USER=20
