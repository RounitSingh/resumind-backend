          "value": "jsonb_typeof(\"customizations\".\"sections\") = 'array' and \"customizations\".\"sections\" <@ '[\"summary\",\"skills\",\"experience\",\"projects\",\"education\",\"certifications\",\"additional\"]'::jsonb"
        },
        "customizations_scores_chk": {
          "name": "customizations_scores_chk",
